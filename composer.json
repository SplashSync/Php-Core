{
    "name":                 "splash/phpcore",
    "description":          "Splash Foundation Module for All Php Applications",

    "type":                 "package",    
    "minimum-stability":    "dev",
    "prefer-stable":        true,
    "license":              "MIT",

    "authors": [
        {
            "name":"Splash Sync",
            "email":"contact@splashsync.com"
        },
        {
            "name": "Bernard Paquier",
            "email": "eshop.bpaquier@gmail.com"
        }
    ],

    "autoload": {
        "psr-4": {
            "Splash\\Core\\":       "src"
        },
        "classmap": ["libs/nusoap/"]
    },
    
    "autoload-dev": {
        "psr-4": {
            "Splash\\Local\\":              "local",
            "Splash\\Core\\Tests\\":        "tests"
        }
    },

    "require": {
        "php":                              "^7.4|^8.0",
        "ext-simplexml":                    "*",
        "ext-xmlwriter":                    "*",
        "ext-libxml":                       "*"
    },

    "require-dev": {
        "ext-xml":                          "*",
        "ext-soap":                         "*",
        "ext-curl":                         "*",
        "ext-apcu":                         "*",
        "badpixxel/php-sdk":                "^2.0|^3.0",
        "phpunit/phpunit":                  "^9.0"
    },
    
    "archive": {
        "exclude": ["/docs", "/local", "/tests"]
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp": true
        }
    }
}
